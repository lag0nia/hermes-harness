          "items": {
            "maxLength": 4096,
            "minLength": 1,
            "type": "string"
          },
          "title": "Changed Paths",
          "type": "array"
        },
        "context_references": {
          "items": {
            "maxLength": 4096,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 100,
          "title": "Context References",
          "type": "array"
        },
        "delivery_target": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Delivery Target",
          "type": "string"
        },
        "event_type": {
          "const": "change",
          "title": "Event Type",
          "type": "string"
        },
        "idempotency_key": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Idempotency Key",
          "type": "string"
