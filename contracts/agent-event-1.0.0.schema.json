          "format": "date-time",
          "title": "Occurred At",
          "type": "string"
        },
        "origin_profile": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Origin Profile",
          "type": "string"
        },
        "origin_session": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Origin Session",
          "type": "string"
        },
        "parent_job_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Job Id"
        },
        "payload": {
          "additionalProperties": true,
          "title": "Payload",
          "type": "object"
        },
        "risk_class": {
          "$ref": "#/$defs/RiskClass"
        },
        "schema_version": {
          "pattern": "^1\\.0\\.\\d+$",
          "title": "Schema Version",
          "type": "string"
        },
        "sequence": {
          "minimum": 0,
          "title": "Sequence",
          "type": "integer"
        },
        "trace_id": {
          "format": "uuid",
          "title": "Trace Id",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "job_id",
        "trace_id",
        "origin_profile",
        "origin_session",
        "delivery_target",
        "intent",
        "idempotency_key",
        "risk_class",
        "model_policy",
        "context_references",
        "sequence",
        "occurred_at",
        "message",
        "payload",
        "event_type",
        "changed_paths",
        "change_kind"
