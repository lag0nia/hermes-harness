{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "observability-event-1.0.0.schema.json",
  "title": "Hermes observability event",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_name", "schema_version", "event_id", "trace_id", "span_id", "event_type", "component", "phase", "status", "criticality", "side_effect_class", "confirmation_state", "occurred_at", "sequence", "summary", "metadata"],
  "properties": {
    "schema_name": {"const": "observability-event"},
    "schema_version": {"const": "1.0.0"},
    "event_id": {"type": "string", "format": "uuid"},
    "trace_id": {"type": "string", "format": "uuid"},
    "span_id": {"type": "string", "format": "uuid"},
    "parent_span_id": {"type": ["string", "null"], "format": "uuid"},
    "job_id": {"type": ["string", "null"], "format": "uuid"},
    "session_id": {"type": ["string", "null"], "maxLength": 256},
    "turn_id": {"type": ["string", "null"], "maxLength": 256},
    "profile": {"type": ["string", "null"], "maxLength": 128},
    "event_type": {"type": "string", "minLength": 1, "maxLength": 128},
    "component": {"type": "string", "minLength": 1, "maxLength": 64},
    "phase": {"type": "string", "minLength": 1, "maxLength": 64},
    "status": {"type": "string", "minLength": 1, "maxLength": 64},
    "criticality": {"enum": ["normal", "critical"]},
    "side_effect_class": {"enum": ["none", "read_only", "reversible", "irreversible"]},
    "confirmation_state": {"enum": ["not_required", "pending", "approved", "denied", "consumed"]},
    "occurred_at": {"type": "string", "format": "date-time"},
    "duration_ms": {"type": ["integer", "null"], "minimum": 0},
    "sequence": {"type": "integer", "minimum": 0},
    "summary": {"type": "string", "minLength": 1, "maxLength": 160},
    "metadata": {"type": "object"},
    "error_code": {"type": ["string", "null"], "maxLength": 128},
    "error_type": {"type": ["string", "null"], "maxLength": 128},
    "error_message": {"type": ["string", "null"], "maxLength": 512}
  }
}
