{
  "$defs": {
    "Confidence": {
      "additionalProperties": false,
      "properties": {
        "score": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Score",
          "type": "number"
        },
        "signals": {
          "items": {
            "maxLength": 4096,
            "minLength": 1,
            "type": "string"
          },
          "title": "Signals",
          "type": "array"
        }
      },
      "required": [
        "score",
        "signals"
      ],
      "title": "Confidence",
      "type": "object"
    },
    "Effort": {
      "enum": [
        "low",
        "medium",
        "high",
        "xhigh"
      ],
      "title": "Effort",
      "type": "string"
    },
    "ErrorCode": {
      "enum": [
        "INVALID_INPUT",
        "UNKNOWN_INTENT",
        "MISSING_REQUIRED_INPUT",
        "AMBIGUOUS_TARGET",
        "CAPABILITY_UNAVAILABLE",
        "PERMISSION_DENIED",
        "CONFIRMATION_REQUIRED",
        "CONFIRMATION_EXPIRED",
        "CONFIRMATION_DIGEST_MISMATCH",
        "AUTHENTICATION_REQUIRED",
        "PROVIDER_UNAVAILABLE",
        "RATE_LIMITED",
        "RESOURCE_PRESSURE",
        "EXTERNAL_STATE_CHANGED",
        "VERIFICATION_FAILED",
        "IDEMPOTENCY_CONFLICT",
        "WORKER_STALE",
        "CYCLE_DETECTED",
        "CANCELLED_BY_USER",
        "ROLLBACK_FAILED"
      ],
      "title": "ErrorCode",
      "type": "string"
    },
    "Intent": {
      "enum": [
        "calendar.create_vtodo",
        "calendar.create_event",
        "calendar.update",
        "calendar.delete",
        "calendar.list",
        "pi.health.read",
        "pi.jobs.list",
        "pi.jobs.cancel",
        "browser.research",
        "browser.order.prepare",
        "browser.form.prepare",
        "browser.auth_required",
        "travel.plan",
        "travel.search_flights",
        "travel.search_stays",
        "technical.research",
        "technical.plan",
        "technical.change",
        "technical.review",
        "code.plan",
        "code.change",
        "code.review",
        "docs.reconcile",
        "docs.query",
        "general.answer",
        "general.clarify"
      ],
      "title": "Intent",
      "type": "string"
    },
    "JobStatus": {
      "enum": [
        "QUEUED",
        "ADMITTED",
        "RUNNING",
        "WAITING_INPUT",
        "WAITING_CONFIRMATION",
        "VERIFYING",
        "BLOCKED",
        "SUCCEEDED",
        "FAILED_RETRYABLE",
        "FAILED_FINAL",
        "ROLLED_BACK",
        "CANCELLED"
      ],
      "title": "JobStatus",
      "type": "string"
    },
    "ModelPolicy": {
      "additionalProperties": false,
      "properties": {
        "context_size_justification": {
          "anyOf": [
            {
              "maxLength": 4096,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Context Size Justification"
        },
        "effort": {
          "$ref": "#/$defs/Effort"
        },
        "model": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "provider": {
          "const": "openai-codex",
          "title": "Provider",
          "type": "string"
        }
      },
      "required": [
        "provider",
        "model",
        "effort"
      ],
      "title": "ModelPolicy",
      "type": "object"
    },
    "RiskClass": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "title": "RiskClass",
      "type": "string"
    },
    "TypedError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        },
        "message": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "TypedError",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifacts": {
      "items": {
        "maxLength": 4096,
        "minLength": 1,
        "type": "string"
      },
      "title": "Artifacts",
      "type": "array"
    },
    "confidence": {
      "$ref": "#/$defs/Confidence"
    },
    "context_references": {
      "items": {
        "maxLength": 4096,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 100,
      "title": "Context References",
      "type": "array"
    },
    "delivery_target": {
      "maxLength": 4096,
      "minLength": 1,
      "title": "Delivery Target",
      "type": "string"
    },
    "documentation_impact": {
      "maxLength": 4096,
      "minLength": 1,
      "title": "Documentation Impact",
      "type": "string"
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/TypedError"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "evidence": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Evidence",
      "type": "array"
    },
    "idempotency_key": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Idempotency Key",
      "type": "string"
    },
    "intent": {
      "$ref": "#/$defs/Intent"
    },
    "job_id": {
      "format": "uuid",
      "title": "Job Id",
      "type": "string"
    },
    "model_policy": {
      "$ref": "#/$defs/ModelPolicy"
    },
    "origin_profile": {
      "maxLength": 4096,
      "minLength": 1,
      "title": "Origin Profile",
      "type": "string"
    },
    "origin_session": {
      "maxLength": 4096,
      "minLength": 1,
      "title": "Origin Session",
      "type": "string"
    },
    "parent_job_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parent Job Id"
    },
    "result": {
      "additionalProperties": true,
      "title": "Result",
      "type": "object"
    },
    "risk_class": {
      "$ref": "#/$defs/RiskClass"
    },
    "schema_version": {
      "pattern": "^1\\.0\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "side_effects": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Side Effects",
      "type": "array"
    },
    "status": {
      "$ref": "#/$defs/JobStatus"
    },
    "summary": {
      "maxLength": 4096,
      "minLength": 1,
      "title": "Summary",
      "type": "string"
    },
    "trace_id": {
      "format": "uuid",
      "title": "Trace Id",
      "type": "string"
    },
    "verification": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Verification",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "job_id",
    "trace_id",
    "origin_profile",
    "origin_session",
    "delivery_target",
    "intent",
    "idempotency_key",
    "risk_class",
    "model_policy",
    "context_references",
    "status",
    "summary",
    "result",
    "evidence",
    "side_effects",
    "verification",
    "confidence",
    "artifacts",
    "documentation_impact"
  ],
  "title": "JobResult",
  "type": "object"
}
