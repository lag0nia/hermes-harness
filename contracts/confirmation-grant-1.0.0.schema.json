{
  "$defs": {
    "Effort": {
      "enum": [
        "low",
        "medium",
        "high",
        "xhigh"
      ],
      "title": "Effort",
      "type": "string"
    },
    "Intent": {
      "enum": [
        "calendar.create_vtodo",
        "calendar.create_event",
        "calendar.update",
        "calendar.delete",
        "calendar.list",
        "pi.health.read",
        "pi.jobs.list",
        "pi.jobs.cancel",
        "browser.research",
        "browser.order.prepare",
        "browser.form.prepare",
        "browser.auth_required",
        "travel.plan",
        "travel.search_flights",
        "travel.search_stays",
        "technical.research",
        "technical.plan",
        "technical.change",
        "technical.review",
        "code.plan",
        "code.change",
        "code.review",
        "docs.reconcile",
        "docs.query",
        "general.answer",
        "general.clarify"
      ],
      "title": "Intent",
      "type": "string"
    },
    "ModelPolicy": {
      "additionalProperties": false,
      "properties": {
        "context_size_justification": {
          "anyOf": [
            {
              "maxLength": 4096,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Context Size Justification"
        },
        "effort": {
          "$ref": "#/$defs/Effort"
        },
        "model": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "provider": {
          "const": "openai-codex",
          "title": "Provider",
          "type": "string"
        }
      },
      "required": [
        "provider",
        "model",
        "effort"
      ],
      "title": "ModelPolicy",
      "type": "object"
    },
    "RiskClass": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "title": "RiskClass",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "confirmation_id": {
      "format": "uuid",
      "title": "Confirmation Id",
      "type": "string"
    },
    "context_references": {
      "items": {
        "maxLength": 4096,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 100,
      "title": "Context References",
      "type": "array"
    },
    "delivery_target": {
      "maxLength": 4096,
      "minLength": 1,
      "title": "Delivery Target",
      "type": "string"
    },
    "digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Digest",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "external_state_version": {
      "maxLength": 4096,
      "minLength": 1,
      "title": "External State Version",
      "type": "string"
    },
    "idempotency_key": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Idempotency Key",
      "type": "string"
    },
    "intent": {
      "$ref": "#/$defs/Intent"
    },
    "issued_at": {
      "format": "date-time",
      "title": "Issued At",
      "type": "string"
    },
    "job_id": {
      "format": "uuid",
      "title": "Job Id",
      "type": "string"
    },
    "model_policy": {
      "$ref": "#/$defs/ModelPolicy"
    },
    "operation": {
      "additionalProperties": true,
      "title": "Operation",
      "type": "object"
    },
    "origin_profile": {
      "maxLength": 4096,
      "minLength": 1,
      "title": "Origin Profile",
      "type": "string"
    },
    "origin_session": {
      "maxLength": 4096,
      "minLength": 1,
      "title": "Origin Session",
      "type": "string"
    },
    "parent_job_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parent Job Id"
    },
    "risk_class": {
      "$ref": "#/$defs/RiskClass"
    },
    "schema_version": {
      "pattern": "^1\\.0\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "trace_id": {
      "format": "uuid",
      "title": "Trace Id",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "job_id",
    "trace_id",
    "origin_profile",
    "origin_session",
    "delivery_target",
    "intent",
    "idempotency_key",
    "risk_class",
    "model_policy",
    "context_references",
    "confirmation_id",
    "digest",
    "issued_at",
    "expires_at",
    "operation",
    "external_state_version"
  ],
  "title": "ConfirmationGrant",
  "type": "object"
}
