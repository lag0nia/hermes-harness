+    @staticmethod
+    def _route_tui_frame(server: Any, frame: dict[str, Any]) -> str | None:
+        """Apply the same deterministic pre-dispatch hook used by Gateway.
+
+        TUI turns do not pass through ``gateway.run._handle_inbound``. Run the
+        hook before creating the session so a new TUI session can be bound to
+        the selected profile. Existing sessions fail closed on profile changes
+        to avoid mixing profile histories.
+        """
+        text = frame.get("text") if "text" in frame else frame.get("prompt", "")
+        try:
+            from types import SimpleNamespace
+
+            from gateway.config import Platform
+            from gateway.platforms.base import MessageEvent
+            from gateway.session import SessionSource
+            from hermes_cli.lifecycle import invoke_hook
+
+            sid = str(frame.get("sid") or "")
+            source = SessionSource(platform=Platform.LOCAL, chat_id=sid, profile=None)
+            event = MessageEvent(text=str(text or ""), source=source)
+            gateway = SimpleNamespace(
+                config=SimpleNamespace(multiplex_profiles=True),
+            )
+            directive = invoke_hook(
+                "pre_gateway_dispatch",
+                event=event,
+                gateway=gateway,
+                session_store=None,
+            )
+        except Exception as exc:
+            # Match Gateway's fail-open hook contract. A broken observer must
+            # not make TUI unavailable; continue on the active/default profile.
+            logger.warning("TUI pre_gateway_dispatch hook failed: %s", exc)
+            return None
+
+        if isinstance(directive, dict):
+            action = directive.get("action")
+            if action == "skip":
+                return str(directive.get("reason") or "turn skipped by routing policy")
+            if action == "rewrite" and isinstance(directive.get("text"), str):
+                frame["text"] = directive["text"]
+
+        target = str(getattr(event.source, "profile", None) or "").strip()
+        if not target or target == "default":
+            return None
+        profile_home = server._profile_home(target)
+        if profile_home is None:
+            return f"routed profile is not served: {target}"
+        existing = server._sessions.get(str(frame.get("sid") or ""))
+        if existing is not None:
+            current_home = str(existing.get("profile_home") or "")
+            if current_home and current_home != str(profile_home):
+                return "routing target changed; start a new TUI session"
+        frame["profile_home"] = str(profile_home)
+        return None
+
     def _ensure_server_session(self, server: Any, frame: dict[str, Any]) -> dict:
         sid = str(frame.get("sid") or "")
         key = str(frame.get("session_key") or sid)
